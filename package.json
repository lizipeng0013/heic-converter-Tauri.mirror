{
  "name": "top.hotime.heic-converter",
  "private": true,
  "version": "0.4.2",
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write src/",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/__tests__/unit",
    "test:e2e": "playwright test",
    "deb": "tauri build && cargo deb --no-build --variant=dsg --manifest-path src-tauri/Cargo.toml && src-tauri/scripts/fixup-dsg-deb.sh && cargo deb --no-build --variant=debian --manifest-path src-tauri/Cargo.toml",
    "deb:dsg": "tauri build && cargo deb --no-build --variant=dsg --manifest-path src-tauri/Cargo.toml && src-tauri/scripts/fixup-dsg-deb.sh",
    "deb:debian": "tauri build && cargo deb --no-build --variant=debian --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@lucide/vue": "^1.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.39",
    "@tauri-apps/api": "~2.12.1",
    "@tauri-apps/plugin-dialog": "~2.8.1",
    "@tauri-apps/plugin-fs": "~2.6.0",
    "@tauri-apps/plugin-log": "~2.10.0",
    "@tauri-apps/plugin-opener": "~2.7.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "~2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "~6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
