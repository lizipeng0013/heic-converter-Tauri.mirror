{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "heic-converter",
  "version": "0.2.0",
  "identifier": "tech.hotime.heic-converter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "heic-converter",
        "width": 800,
        "height": 700,
        "label": "main",
        "decorations": false,
        "resizable": true,
        "center": true,
        "hiddenTitle": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
