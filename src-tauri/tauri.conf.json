{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "heic-converter",
  "version": "0.3.0",
  "identifier": "tech.hotime.heic-converter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "heic-converter",
        "width": 800,
        "height": 700,
        "label": "main",
        "decorations": false,
        "resizable": true,
        "center": true,
        "hiddenTitle": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {},
        "depends": [
          "libgtk-3-0 (>= 3.24)",
          "libwebkit2gtk-4.1-0 (>= 2.38)",
          "libheif1 (>= 1.18)",
          "libde265-0 (>= 1.0)",
          "libx265-199 (>= 2.5)"
        ]
      },
      "rpm": {
        "epoch": 0,
        "files": {}
      }
    }
  }
}
